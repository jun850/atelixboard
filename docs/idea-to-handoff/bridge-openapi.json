  "components": {
    "securitySchemes": {
      "bridgeServiceAssertion": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Our asymmetric service JWT: allowlisted issuer/audience/key, maximum 60-second validity, unique jti per transport attempt and operation scope. Actor permissions are checked separately. Not a Docmost enterprise API key or Supabase user token."
      }
    },
    "schemas": {
      "ActorContext": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actorId": {
            "type": "string",
            "format": "uuid"
          },
          "projectId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["actorId", "projectId"]
      },
      "PageCreate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actorId": {
            "type": "string",
            "format": "uuid"
          },
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "handoffVersionId": {
            "type": "string",
            "format": "uuid"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "markdown": {
            "type": "string",
            "maxLength": 200000
          }
        },
        "required": ["actorId", "projectId", "handoffVersionId", "correlationId", "title", "markdown"]
      },
      "PageLookup": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actorId": {
            "type": "string",
            "format": "uuid"
          },
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "pageId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["actorId", "projectId", "pageId"]
      },
      "ReconcileInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actorId": {
            "type": "string",
            "format": "uuid"
          },
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["actorId", "projectId", "correlationId"]
      },
      "Page": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pageId": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "spaceId": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "correlationId": {
            "type": ["string", "null"],
            "format": "uuid"
          }
        },
        "required": ["pageId", "workspaceId", "spaceId", "url", "correlationId"]
      },
      "Access": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "spaceId": {
            "type": "string",
            "format": "uuid"
          },
          "canRead": {
            "type": "boolean"
          },
          "canCreate": {
            "type": "boolean"
          },
          "parityVerified": {
            "type": "boolean"
          }
        },
        "required": ["projectId", "spaceId", "canRead", "canCreate", "parityVerified"]
      },
      "Reconciliation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "state": {
            "type": "string",
            "enum": ["found", "pending", "absent"]
          },
          "page": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Page"
              },
              {
                "type": "null"
              }
            ]
          },
          "safeToRetry": {
            "type": "boolean"
          }
        },
        "required": ["state", "page", "safeToRetry"]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "null"
          },
          "success": {
            "const": false
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            },
            "required": ["code", "message", "requestId"]
          }
        },
        "required": ["data", "success", "status", "error"]
      }
    }
  }
}
