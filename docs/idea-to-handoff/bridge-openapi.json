{
  "openapi": "3.1.0",
  "info": {
    "title": "Boardy custom Docmost Community bridge",
    "version": "0.1.0-proposed",
    "description": "Not implemented. Uses independently implemented service assertions, verified dual-session account links, native community authorization and core services. No enterprise API-key dependency. See DOCMOST-OSS-INTEGRATION.md for security, transaction and mapping gates. Account linking and space provisioning contracts are deliberately not complete here."
  },
  "servers": [
    {
      "url": "/api/boardy-bridge/v1",
      "description": "Custom routes on self-hosted maintained Docmost fork"
    }
  ],
  "security": [
    {
      "bridgeServiceAssertion": []
    }
  ],
  "paths": {
    "/spaces/verify": {
      "post": {
        "operationId": "verifyProjectSpace",
        "summary": "verifyProjectSpace",
        "description": "Custom implementation in the maintained community fork, not an upstream Docmost API. Derive workspace/space from verified server mapping; never trust arbitrary client space IDs.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActorContext"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Custom bridge success; status mirrors HTTP",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Access"
                    },
                    "success": {
                      "const": true
                    },
                    "status": {
                      "const": 200
                    }
                  },
                  "required": ["data", "success", "status"]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid service assertion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Actor lacks native permission or project access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Mapping or page unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Correlation conflict or parity drift",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Access verification or core service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
