{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://excalidraw.com"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Feature-Policy",
          "value": "*"
        },
        {
          "key": "Referrer-Policy",
          "value": "origin"
        }
      ]
    },
    {
      "source": "/:file*.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://excalidraw.com"
        }
      ]
    },
    {
      "source": "/(Virgil|Cascadia|Assistant-Regular).woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/app/visibility",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/webex/:match*",
      "destination": "https://for-webex.excalidraw.com"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "vscode.excalidraw.com"
        }
      ],
      "destination": "https://marketplace.visualstudio.com/items?itemName=pomdtr.excalidraw-editor"
    }
  ],
  "rewrites": [
    {
      "source": "/learn",
      "destination": "https://atelix-prime-dune.shadowdocument.com/learn"
    },
    {
      "source": "/learn/:path*",
      "destination": "https://atelix-prime-dune.shadowdocument.com/learn/:path*"
    },
    {
      "source": "/ai",
      "destination": "/api/discovery?path=/ai"
    },
    {
      "source": "/mcp",
      "destination": "/api/discovery?path=/mcp"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/discovery?path=/llms.txt"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/api/discovery?path=/llms-full.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/discovery?path=/sitemap.xml"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "outputDirectory": "excalidraw-app/build",
  "installCommand": "yarn install"
}
